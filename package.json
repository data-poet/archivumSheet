{
  "name": "archivumsheet",
  "version": "1.10.33",
  "description": "Online GURPS (Archivum) Character Sheet",
  "main": "dev/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "node --watch-path=data --watch-path=engine --watch-path=helpers dev/server.js",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:data": "jest --selectProjects data",
    "check:data": "node scripts/checkData.js",
    "check:comments-only": "node scripts/commentsOnlyCheck.js",
    "data:import": "node scripts/importData.js",
    "data:keys": "node scripts/generateKeys.js",
    "data:format": "node scripts/formatData.js",
    "data:remap": "node scripts/remapReferences.js",
    "golden:record": "node scripts/golden.js record",
    "golden:compare": "node scripts/golden.js compare",
    "coverage:record": "node scripts/golden.js coverage-record",
    "coverage:compare": "node scripts/golden.js coverage-compare",
    "test:renumber": "node scripts/renumberCheck.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "babel-jest": "^30.4.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "express": "^5.2.1"
  }
}
